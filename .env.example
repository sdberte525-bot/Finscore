# Public URL of the deployed site, used for canonical links, sitemap and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://swolvation.com

# Payments. Leave empty and the checkout page says payments aren't connected yet.
# With a key set, /api/checkout creates a Stripe Checkout Session from the bag.
STRIPE_SECRET_KEY=

# Newsletter. A URL that accepts POST {"email": "..."} as JSON (Klaviyo, Mailchimp,
# ConvertKit, Zapier, or your own endpoint). Leave empty to disable signups.
NEWSLETTER_WEBHOOK_URL=
