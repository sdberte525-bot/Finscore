# Public URL of the deployed site: canonical links, sitemap, share previews, checkout redirects.
NEXT_PUBLIC_SITE_URL=https://swolvation.com

# --- Commerce: pick one -------------------------------------------------------
# Option A (recommended for launch): Shopify manages products, inventory, orders and checkout.
# COMMERCE_PROVIDER=shopify
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2025-01

# Option B: products live in src/data/products.ts and checkout runs through Stripe.
STRIPE_SECRET_KEY=
# Countries Stripe collects shipping addresses for, e.g. "US,CA". Leave empty to skip.
STRIPE_SHIPPING_COUNTRIES=

# With neither configured, the checkout page says payments aren't connected and no order can be placed.

# --- Contact form: pick one ---------------------------------------------------
# Send messages by email through Resend (resend.com):
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Swolvation <hello@swolvation.com>".
CONTACT_FROM_EMAIL=
# Or forward messages as JSON to any webhook (Zapier, Make, Formspree, a helpdesk):
CONTACT_WEBHOOK_URL=

# --- Newsletter ---------------------------------------------------------------
# A URL that accepts POST {"email": "..."} (Klaviyo, Mailchimp, ConvertKit, Zapier...).
NEWSLETTER_WEBHOOK_URL=
