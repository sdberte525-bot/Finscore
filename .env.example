# Copy to .env.local for local development, or add the same keys in
# Netlify > Site configuration > Environment variables. See SHOPIFY_SETUP.md.

# Public URL of the deployed site: canonical links, sitemap, share previews, checkout redirects.
NEXT_PUBLIC_SITE_URL=https://swolvation.com

# --- Store status ---------------------------------------------------------------
# Unset: the store opens automatically once a checkout (Shopify or Stripe) is connected.
# prelaunch: keep "Coming soon / Notify me" even with checkout connected (until drop day).
# open: always show add-to-cart.
# STORE_MODE=prelaunch

# --- Commerce: pick one -----------------------------------------------------------
# Option A (recommended): Shopify manages products, inventory, orders and checkout.
# COMMERCE_PROVIDER=shopify
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront API token (Headless channel). Scopes: product listings, inventory, checkouts.
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API token (custom app) with the write_customers scope: sends email sign-ups to Shopify customers.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2025-01

# Option B: products live in src/data/products.ts and checkout runs through Stripe.
STRIPE_SECRET_KEY=
# Countries Stripe collects shipping addresses for, e.g. "US,CA". Leave empty to skip.
STRIPE_SHIPPING_COUNTRIES=

# --- Email list (first configured wins) ------------------------------------------
# 1. Shopify: set SHOPIFY_STORE_DOMAIN + SHOPIFY_ADMIN_ACCESS_TOKEN above.
# 2. Klaviyo:
# KLAVIYO_PRIVATE_API_KEY=
# KLAVIYO_LIST_ID=
# 3. Any webhook that accepts POST {"email","source","tags"}:
NEWSLETTER_WEBHOOK_URL=
# 4. Nothing set: sign-ups go to Netlify Forms (form "newsletter"). Turn on form detection in Netlify.

# --- Contact form (first configured wins; otherwise Netlify Forms, form "contact") ---
# Resend (resend.com):
RESEND_API_KEY=
CONTACT_TO_EMAIL=swolvation@gmail.com
# Must be an address on a domain verified in Resend, e.g. "Swolvation <hello@swolvation.com>".
CONTACT_FROM_EMAIL=
# Or forward messages as JSON to any webhook (Zapier, Make, Formspree, a helpdesk):
CONTACT_WEBHOOK_URL=
