{%- capture body -%}
  {%- form 'reset_customer_password', class: 'grid gap-8' -%}
    {%- if form.errors -%}<p role="alert" class="text-[0.9375rem] text-oxblood">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div><label for="reset-pw" class="block text-[0.9375rem]">New password</label><input id="reset-pw" type="password" name="customer[password]" autocomplete="new-password" required class="w-full rounded-none border-0 border-b border-ink/30 bg-transparent px-0 py-3 text-base outline-none transition-colors focus:border-ink focus-visible:outline-none"></div>
    <div><label for="reset-pw2" class="block text-[0.9375rem]">Confirm password</label><input id="reset-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required class="w-full rounded-none border-0 border-b border-ink/30 bg-transparent px-0 py-3 text-base outline-none transition-colors focus:border-ink focus-visible:outline-none"></div>
    <button type="submit" class="button button-solid sm:w-fit">Reset password</button>
  {%- endform -%}
{%- endcapture -%}
{%- render 'account-frame', title: 'Reset your password', body: body -%}

{% schema %}
{ "name": "Reset password", "class": "section-reset-password", "settings": [] }
{% endschema %}
