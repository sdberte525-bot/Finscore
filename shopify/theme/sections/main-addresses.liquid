{%- capture body -%}
  <a href="{{ routes.account_url }}" class="link-underline text-[0.9375rem] text-ash">Back to your account</a>
  {%- paginate customer.addresses by 10 -%}
    <ul class="mt-8 space-y-8">
      {%- for address in customer.addresses -%}
        <li class="border-t border-ink/15 pt-6 text-[0.9375rem]">
          {%- if address == customer.default_address -%}<p class="caps text-ash">Default</p>{%- endif -%}
          <div class="mt-2">{{ address | format_address }}</div>
          <details class="mt-4">
            <summary class="cursor-pointer list-none underline underline-offset-4 [&::-webkit-details-marker]:hidden">Edit</summary>
            {%- form 'customer_address', address, class: 'mt-6 grid gap-6' -%}
              {%- render 'address-fields', form: form, id: address.id -%}
              <button type="submit" class="button button-solid sm:w-fit">Save address</button>
            {%- endform -%}
          </details>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" class="mt-3">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="text-sm text-ash underline underline-offset-4">Delete</button>
          </form>
        </li>
      {%- endfor -%}
    </ul>
  {%- endpaginate -%}
  <details class="mt-12 border-t border-ink/15 pt-6" {% if customer.addresses_count == 0 %}open{% endif %}>
    <summary class="display cursor-pointer list-none text-[2rem] [&::-webkit-details-marker]:hidden">Add an address</summary>
    {%- form 'customer_address', customer.new_address, class: 'mt-6 grid gap-6' -%}
      {%- render 'address-fields', form: form, id: 'new' -%}
      <button type="submit" class="button button-solid sm:w-fit">Add address</button>
    {%- endform -%}
  </details>
{%- endcapture -%}
{%- render 'account-frame', title: 'Addresses', body: body -%}

{% schema %}
{ "name": "Addresses", "class": "section-addresses", "settings": [] }
{% endschema %}
