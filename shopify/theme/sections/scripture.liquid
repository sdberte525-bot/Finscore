<section data-reveal-scope class="gutter bg-bone py-20 md:py-32">
  <div data-rise class="max-w-3xl">
    <p class="caps text-ash">{{ section.settings.eyebrow }}</p>
    <h2 class="display mt-4 text-[3.25rem] md:text-[5rem]">{{ section.settings.heading }}</h2>
  </div>
  <div class="mt-14 space-y-20 md:mt-20 md:space-y-28">
    {%- for block in section.blocks -%}
      {%- capture handle -%}{%- render 'resolve-product', block: block -%}{%- endcapture -%}
      {%- assign p = all_products[handle] -%}
      {%- liquid
        assign verse = block.settings.verse
        assign reference = block.settings.reference
        assign description = block.settings.description
        assign href = routes.all_products_collection_url
        if verse == blank and p == blank
          if block.settings.builtin_image contains 'ls-'
            assign verse = 'I can do all things through Christ who strengthens me.'
            assign reference = reference | default: 'Philippians 4:13'
          else
            assign verse = 'Be strong and courageous.'
            assign reference = reference | default: 'Joshua 1:9'
          endif
        endif
        if p != blank
          if verse == blank
            capture verse
              render 'product-merch', product: p, field: 'scripture_text'
            endcapture
          endif
          if reference == blank
            capture reference
              render 'product-merch', product: p, field: 'scripture_reference'
            endcapture
          endif
          if description == blank
            assign description = p.description | strip_html | strip
          endif
          assign href = p.url
        endif
        assign odd = forloop.index0 | modulo: 2
      -%}
      <div class="grid items-center gap-10 md:grid-cols-12 md:gap-8" {{ block.shopify_attributes }}>
        <div class="md:col-span-5 {% if odd == 1 %}md:order-last md:col-start-8{% endif %}">
          <div data-reveal class="relative aspect-[4/5] overflow-hidden bg-charcoal">
            {%- render 'campaign-image', image: block.settings.image, key: block.settings.builtin_image, alt: block.settings.alt, sizes: '(min-width: 768px) 40vw, 92vw', class: 'absolute inset-0 h-full w-full object-cover' -%}
          </div>
        </div>
        <figure data-rise class="md:col-span-6 {% if odd == 1 %}md:col-start-1 md:row-start-1{% else %}md:col-start-7{% endif %}">
          <blockquote class="display text-[2.5rem] leading-[1.02] md:text-[4rem]">
            <p>&ldquo;{{ verse }}&rdquo;</p>
          </blockquote>
          <figcaption class="caps mt-6 text-ash">{{ reference }}</figcaption>
          <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-charcoal">{{ description }}</p>
          <a href="{{ href }}" class="button button-solid mt-8">{{ block.settings.button_label }}</a>
        </figure>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Verses",
  "class": "section-scripture",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Worn with purpose" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every piece carries a verse." }
  ],
  "blocks": [
    {
      "type": "verse",
      "name": "Verse",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "handle", "label": "Or product handle" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "builtin_image", "label": "Built-in image", "default": "tee-studio-back",
          "options": [
            { "value": "tee-studio-back", "label": "Tee, back" },
            { "value": "ls-studio-back", "label": "Long sleeve, back" },
            { "value": "tee-studio-front", "label": "Tee, front" },
            { "value": "ls-studio-front", "label": "Long sleeve, front" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Image description (alt text)" },
        { "type": "textarea", "id": "verse", "label": "Verse", "info": "Leave empty to use the product's verse." },
        { "type": "text", "id": "reference", "label": "Reference", "info": "Leave empty to use the product's." },
        { "type": "textarea", "id": "description", "label": "Text", "info": "Leave empty to use the product description." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the tee" }
      ]
    }
  ],
  "presets": [{ "name": "Verses" }]
}
{% endschema %}
