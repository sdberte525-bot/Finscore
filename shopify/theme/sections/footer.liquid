{%- liquid
  assign shop_url = routes.all_products_collection_url
-%}
<footer data-tone="dark" class="relative overflow-hidden border-t border-bone/10 bg-ink text-bone">
  <div class="gutter pb-12 pt-24 md:pt-32">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="display text-[2.5rem] md:text-[3.25rem]">{{ section.settings.heading }}</h2>
        <p class="mt-4 max-w-[40ch] text-stone">{{ section.settings.text }}</p>
        <div class="mt-8">
          {%- render 'newsletter-form', source: 'footer', id: 'footer' -%}
        </div>
        <ul class="mt-6 flex flex-wrap gap-3" aria-label="Follow {{ shop.name }}">
          {%- render 'social-links', style: 'footer' -%}
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-6 lg:col-start-7">
        <nav aria-label="Shop">
          <h3 class="text-sm text-stone">Shop</h3>
          <ul class="mt-5 space-y-3 text-[0.9375rem]">
            <li><a href="{{ shop_url }}" class="link-underline">Shop all</a></li>
            {%- if collections['new-drop'].id != blank -%}<li><a href="{{ collections['new-drop'].url }}" class="link-underline">New drop</a></li>{%- endif -%}
            <li><a href="{{ shop_url }}?category=tee" class="link-underline">Short sleeves</a></li>
            <li><a href="{{ shop_url }}?category=long-sleeve" class="link-underline">Long sleeves</a></li>
            <li><a href="{{ routes.cart_url }}" class="link-underline">Cart</a></li>
          </ul>
        </nav>
        <nav aria-label="Help">
          <h3 class="text-sm text-stone">Help</h3>
          <ul class="mt-5 space-y-3 text-[0.9375rem]">
            {%- comment -%} Only link pages and policies that exist, so no footer link lands on a 404. {%- endcomment -%}
            {%- if pages.faq.url != blank -%}<li><a href="{{ pages.faq.url }}" class="link-underline">FAQ</a></li>{%- endif -%}
            {%- if pages.shipping.url != blank -%}
              <li><a href="{{ pages.shipping.url }}" class="link-underline">Shipping</a></li>
            {%- elsif shop.shipping_policy.url != blank -%}
              <li><a href="{{ shop.shipping_policy.url }}" class="link-underline">Shipping</a></li>
            {%- endif -%}
            {%- if pages.returns.url != blank -%}
              <li><a href="{{ pages.returns.url }}" class="link-underline">Returns and exchanges</a></li>
            {%- elsif shop.refund_policy.url != blank -%}
              <li><a href="{{ shop.refund_policy.url }}" class="link-underline">Returns and refunds</a></li>
            {%- endif -%}
            {%- if pages['size-guide'].url != blank -%}<li><a href="{{ pages['size-guide'].url }}" class="link-underline">Size guide</a></li>{%- endif -%}
            <li><a href="/pages/contact" class="link-underline">Contact us</a></li>
            {%- if shop.customer_accounts_enabled -%}
              <li><a href="{{ routes.account_url }}" class="link-underline">{% if customer %}Your account{% else %}Sign in{% endif %}</a></li>
            {%- endif -%}
          </ul>
        </nav>
        <nav aria-label="Company">
          <h3 class="text-sm text-stone">Company</h3>
          <ul class="mt-5 space-y-3 text-[0.9375rem]">
            {%- if pages.about.url != blank -%}<li><a href="{{ pages.about.url }}" class="link-underline">Our story</a></li>{%- endif -%}
            <li><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" class="link-underline">Privacy policy</a></li>
            {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}" class="link-underline">Terms and conditions</a></li>{%- endif -%}
          </ul>
        </nav>
      </div>
    </div>
  </div>

  <div class="gutter" aria-hidden="true">
    <p class="wordmark select-none whitespace-nowrap text-center text-[10.6vw] leading-none tracking-[0.08em] text-bone/[0.08]">
      {{ shop.name | default: 'Swolvation' }}
    </p>
  </div>

  <div class="gutter flex flex-col gap-3 border-t border-bone/10 py-8 text-sm text-stone sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.legal_name | default: shop.name }}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      {%- if settings.contact_email != blank -%}
        <a href="mailto:{{ settings.contact_email }}" class="link-underline">{{ settings.contact_email }}</a>
      {%- endif -%}
      <span>{{ settings.tagline }}</span>
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get first access" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New drops go to the list first. Occasional emails about releases and restocks, nothing else." }
  ]
}
{% endschema %}
