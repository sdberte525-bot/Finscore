<div data-tone="light" class="gutter flex min-h-[80vh] flex-col justify-center bg-bone pb-24 pt-32">
  <h1 class="display text-[3.5rem] md:text-[6rem]">{{ section.settings.heading }}</h1>
  <p class="mt-6 max-w-[40ch] text-lg">{{ section.settings.text }}</p>
  <div class="mt-10 flex flex-wrap gap-3">
    <a href="{{ routes.all_products_collection_url }}" class="button button-solid">Shop the collection</a>
    <a href="{{ routes.root_url }}" class="button">Go home</a>
  </div>
</div>

{% schema %}
{
  "name": "Page not found",
  "class": "section-404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Missed rep." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "This page doesn’t exist. It may have moved, or the link has a typo." }
  ]
}
{% endschema %}
