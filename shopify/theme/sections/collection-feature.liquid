<section data-tone="dark" data-reveal-scope class="bg-ink text-bone">
  <div class="grid md:grid-cols-12">
    <div class="md:col-span-7">
      {%- render 'editorial-image', image: section.settings.image, key: 'tee-gym-hook', alt: section.settings.alt, aspect: 'aspect-[4/5] md:aspect-auto md:h-full md:min-h-[46rem]', sizes: '(min-width: 768px) 58vw, 100vw' -%}
    </div>
    <div class="gutter flex flex-col justify-between gap-14 py-16 md:col-span-5 md:py-20 lg:px-16">
      <div data-rise>
        <h2 class="display text-[3.25rem] md:text-[4.5rem]">{{ section.settings.heading }}</h2>
        <p class="mt-6 max-w-[36ch] text-lg leading-relaxed text-stone">{{ section.settings.text }}</p>
        <div class="mt-10">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button-light">{{ section.settings.button_label }}</a>
        </div>
      </div>
      <figure data-rise class="w-full max-w-[18rem]">
        {%- render 'loop-video',
          video: section.settings.video,
          src: section.settings.video_url,
          poster_key: 'poster-tee-sweep',
          poster_image: section.settings.poster,
          alt: 'A beam of light sweeping across the back print of the Be Strong & Courageous tee',
          sizes: '288px',
          class: 'aspect-[4/5] bg-charcoal'
        -%}
        <figcaption class="mt-3 text-sm text-stone">{{ section.settings.caption }}</figcaption>
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign feature",
  "class": "section-collection-feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait (4:5). Defaults to the tee hanging in the gym at dawn." },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "The Be Strong & Courageous tee hanging on a hook in an old-school gym at dawn, back print lit by window light" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than what you wear." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Made for those who keep showing up. In the gym, in life, and through every challenge." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" },
    { "type": "header", "content": "Detail video" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "text", "id": "video_url", "label": "Or video URL (MP4)", "default": "https://d2ol7oe51mr4n9.cloudfront.net/user_3KW4bOaWnBSh6zRqm3msREW6Jea/9d9eede1-c0e9-4847-affa-f63d81d76c06.mp4" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "The back print, distressed cream on vintage black." }
  ],
  "presets": [{ "name": "Campaign feature" }]
}
{% endschema %}
