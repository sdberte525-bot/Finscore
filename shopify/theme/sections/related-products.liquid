{%- liquid
  assign shown = 0
-%}
{%- capture cards -%}
  {%- for p in collections['all'].products -%}
    {%- if p.handle != product.handle and shown < section.settings.limit -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- render 'product-card', product: p, sizes: '(min-width: 640px) 48vw, 92vw', priority: false -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
  {%- liquid
    if shown <= 2
      assign columns = 'sm:grid-cols-2'
    elsif shown == 3
      assign columns = 'sm:grid-cols-2 lg:grid-cols-3'
    else
      assign columns = 'sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4'
    endif
  -%}
  <section class="gutter mt-20 border-t border-ink/10 bg-bone pb-24 pt-16 md:mt-28 md:pb-32 md:pt-20" aria-labelledby="related-title">
    <h2 id="related-title" class="display text-[2.5rem] md:text-[3.5rem]">{{ section.settings.heading }}</h2>
    <div class="mt-10">
      <div class="grid gap-x-5 gap-y-12 md:gap-x-8 {{ columns }}">{{ cards }}</div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "class": "section-related bg-bone",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the drop" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 1, "max": 8, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
