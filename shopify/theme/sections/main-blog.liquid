{%- paginate blog.articles by 12 -%}
<div class="gutter min-h-[80vh] bg-bone pb-24 pt-12 md:pb-32 md:pt-16">
  <h1 class="display text-[3.5rem] md:text-[6rem]">{{ blog.title }}</h1>
  <ul class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
    {%- for article in blog.articles -%}
      <li>
        <a href="{{ article.url }}" class="group block">
          {%- if article.image -%}
            <span class="relative block aspect-[4/5] overflow-hidden bg-charcoal">
              {{ article.image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 92vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]', loading: 'lazy' }}
            </span>
          {%- endif -%}
          <span class="mt-4 block text-sm text-ash">{{ article.published_at | date: '%B %-d, %Y' }}</span>
          <span class="link-underline mt-1 inline text-lg">{{ article.title }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  {%- if paginate.pages > 1 -%}
    <nav class="mt-16 flex items-center justify-between border-t border-ink/10 pt-6 text-sm" aria-label="Pages">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="link-underline">Newer</a>{%- else -%}<span></span>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="link-underline">Older</a>{%- endif -%}
    </nav>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "class": "section-main-blog", "settings": [] }
{% endschema %}
