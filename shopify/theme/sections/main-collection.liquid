{%- comment -%}
  Collection pages. /collections/all is "Shop all" with category filters; the collection with
  the handle "new-drop" gets the dark New drop header; any other collection uses its own title
  and description.
{%- endcomment -%}
{%- paginate collection.products by 48 -%}
{%- liquid
  assign is_drop = false
  if collection.handle == 'new-drop' or collection.template_suffix == 'new-drop'
    assign is_drop = true
  endif
  assign list = collection.products
  if list.size == 0 and is_drop
    assign list = collections['all'].products
  endif
-%}
{%- if is_drop -%}
  <div>
    <section data-tone="dark" class="gutter bg-ink py-20 text-bone md:py-28">
      <p class="caps text-stone">{{ section.settings.drop_eyebrow }}</p>
      <h1 class="display mt-4 text-[4rem] sm:text-[6rem] lg:text-[8.5rem]">{{ section.settings.drop_heading }}</h1>
      <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
        <p class="max-w-[46ch] text-lg leading-relaxed text-stone">
          {%- if collection.description != blank -%}
            {{ collection.description | strip_html }}
          {%- else -%}
            Purpose in every piece. {% if list.size == 2 %}Two{% else %}{{ list.size }}{% endif %} designs to start, each with a small logo on the front and a large scripture graphic across the back.
          {%- endif -%}
        </p>
        <a href="/pages/size-guide" class="caps link-underline py-2 text-stone hover:text-bone">Size guide</a>
      </div>
    </section>
    <section class="gutter bg-bone py-16 md:py-24" aria-label="Products in {{ collection.title | escape }}" data-reveal-tiles>
      {%- render 'product-grid', products: list -%}
    </section>
  </div>
{%- else -%}
  <div class="gutter min-h-[80vh] bg-bone pb-24 pt-12 md:pb-32 md:pt-16" data-shop>
    <nav aria-label="Breadcrumb" class="text-sm text-ash">
      <ol class="flex gap-2">
        <li><a href="{{ routes.root_url }}" class="link-underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{% if collection.handle == 'all' %}Shop{% else %}{{ collection.title }}{% endif %}</li>
      </ol>
    </nav>
    <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
      <h1 class="display text-[3.5rem] md:text-[6rem]">{% if collection.handle == 'all' %}{{ section.settings.all_heading }}{% else %}{{ collection.title }}{% endif %}</h1>
      <p class="max-w-[40ch] text-charcoal md:text-right">
        {%- if collection.handle != 'all' and collection.description != blank -%}{{ collection.description | strip_html }}{%- else -%}{{ section.settings.intro }}{%- endif -%}
      </p>
    </div>

    {%- liquid
      assign has_tee = false
      assign has_ls = false
      for p in list
        capture c
          render 'product-merch', product: p, field: 'category'
        endcapture
        if c == 'tee'
          assign has_tee = true
        else
          assign has_ls = true
        endif
      endfor
    -%}
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-y border-ink/10 py-4">
      <nav aria-label="Filter products">
        <ul class="flex flex-wrap gap-2">
          <li><button type="button" data-filter="" aria-pressed="true" class="caps min-h-11 rounded-[2px] border border-ink bg-ink px-4 text-bone transition-colors">All products</button></li>
          {%- if has_tee -%}
            <li><button type="button" data-filter="tee" aria-pressed="false" class="caps min-h-11 rounded-[2px] border border-ink/15 px-4 transition-colors hover:border-ink">Short sleeves</button></li>
          {%- endif -%}
          {%- if has_ls -%}
            <li><button type="button" data-filter="long-sleeve" aria-pressed="false" class="caps min-h-11 rounded-[2px] border border-ink/15 px-4 transition-colors hover:border-ink">Long sleeves</button></li>
          {%- endif -%}
        </ul>
      </nav>
      <p class="text-sm tabular-nums text-ash" aria-live="polite" data-filter-count>{{ list.size }} {{ list.size | pluralize: 'product', 'products' }}</p>
    </div>

    <div class="mt-8" data-reveal-tiles>
      {%- if list.size == 0 -%}
        <div class="py-20">
          <p class="text-lg">Nothing in this category yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button-solid mt-6">See all products</a>
        </div>
      {%- else -%}
        {%- render 'product-grid', products: list, filterable: true -%}
        <div class="py-20" data-filter-empty hidden>
          <p class="text-lg">Nothing in this category yet.</p>
          <button type="button" data-filter="" class="button button-solid mt-6">See all products</button>
        </div>
      {%- endif -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="mt-16 flex items-center justify-between border-t border-ink/10 pt-6 text-sm" aria-label="Pages">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="link-underline">Previous</a>{%- else -%}<span></span>{%- endif -%}
        <span class="text-ash">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="link-underline">Next</a>{%- else -%}<span></span>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
{%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "header", "content": "Shop all" },
    { "type": "text", "id": "all_heading", "label": "Heading", "default": "Shop all" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Vintage-inspired training apparel rooted in strength, discipline, and purpose." },
    { "type": "header", "content": "New drop collection" },
    { "type": "paragraph", "content": "Used by the collection with the handle new-drop." },
    { "type": "text", "id": "drop_eyebrow", "label": "Eyebrow", "default": "New drop" },
    { "type": "text", "id": "drop_heading", "label": "Heading", "default": "The first drop" }
  ]
}
{% endschema %}
