<div data-tone="light" class="gutter min-h-[80vh] bg-bone pb-24 pt-12 md:pt-16" data-cart-page>
  <h1 class="display text-[3.5rem] md:text-[6rem]">Cart</h1>

  {%- if cart.item_count == 0 -%}
    <div class="mt-10 max-w-md">
      <p class="text-lg">Your cart is empty.</p>
      <p class="mt-2 text-ash">Pieces you add stay here on this device until you check out.</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button-solid mt-8">Shop the collection</a>
    </div>
  {%- else -%}
    <div class="mt-12 grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="border-t border-ink/15 lg:col-span-7">
        {%- render 'cart-lines', compact: false -%}
      </div>
      <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="summary-title">
        <form action="{{ routes.cart_url }}" method="post" class="lg:sticky lg:top-28">
          <h2 id="summary-title" class="text-sm text-ash">Summary</h2>
          <dl class="mt-6 space-y-3 border-t border-ink/15 pt-6 text-sm">
            <div class="flex justify-between">
              <dt>Subtotal, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</dt>
              <dd class="tabular-nums">{{ cart.items_subtotal_price | money_without_trailing_zeros }}</dd>
            </div>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="flex justify-between text-ash">
                <dt>{{ discount.title }}</dt>
                <dd class="tabular-nums">&minus;{{ discount.total_allocated_amount | money_without_trailing_zeros }}</dd>
              </div>
            {%- endfor -%}
            <div class="flex justify-between text-ash">
              <dt>Shipping</dt>
              <dd>Calculated at checkout</dd>
            </div>
            {%- if cart.total_discount > 0 -%}
              <div class="flex justify-between">
                <dt>Total</dt>
                <dd class="tabular-nums">{{ cart.total_price | money_without_trailing_zeros }}</dd>
              </div>
            {%- endif -%}
          </dl>
          <button type="submit" name="checkout" class="button button-solid mt-8 w-full">Checkout</button>
          <p class="mt-3 text-xs text-ash">Discount codes, shipping and taxes are applied at checkout.</p>
          <a href="{{ routes.all_products_collection_url }}" class="link-underline mt-5 inline-block text-sm">Keep shopping</a>
        </form>
      </aside>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
