{%- liquid
  assign open = false
  if settings.store_mode == 'open'
    assign open = true
  endif
  capture key
    render 'product-merch', product: product, field: 'key'
  endcapture
  capture category
    render 'product-merch', product: product, field: 'category'
  endcapture
  capture verse
    render 'product-merch', product: product, field: 'scripture_text'
  endcapture
  capture reference
    render 'product-merch', product: product, field: 'scripture_reference'
  endcapture
  capture details
    render 'product-merch', product: product, field: 'details'
  endcapture
  capture material
    render 'product-merch', product: product, field: 'material'
  endcapture
  capture care
    render 'product-merch', product: product, field: 'care'
  endcapture

  assign curated = ''
  if key != blank and settings.launch_gallery != 'shopify'
    assign curated = key
  endif
  if key != blank and product.media.size == 0
    assign curated = key
  endif

  if category == 'long-sleeve'
    assign category_label = 'Long sleeves'
    assign fit_note = settings.size_ls_fit
  else
    assign category_label = 'Short sleeves'
    assign fit_note = settings.size_tee_fit
  endif

  assign current = product.selected_or_first_available_variant
  assign preselected = product.selected_variant
-%}

<div class="bg-bone pb-4 lg:pt-8" data-product data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}">
  <div class="lg:gutter lg:grid lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      {%- render 'product-gallery', product: product, curated: curated -%}
    </div>

    <div class="gutter pt-8 lg:col-span-4 lg:col-start-9 lg:px-0 lg:pt-0">
      <div class="lg:sticky lg:top-24">
        <nav aria-label="Breadcrumb" class="text-sm text-ash">
          <ol class="flex flex-wrap gap-2">
            <li><a href="{{ routes.root_url }}" class="link-underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="{{ routes.all_products_collection_url }}" class="link-underline">Shop</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="{{ routes.all_products_collection_url }}?category={{ category }}" class="link-underline">{{ category_label }}</a></li>
          </ol>
        </nav>

        <p class="caps mt-6 text-ash">{{ shop.name }}</p>
        <h1 class="display mt-2 text-[2.75rem] md:text-[3.5rem]">{{ product.title }}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <p class="text-xl tabular-nums" data-price>{{ current.price | money_without_trailing_zeros }}</p>
          {%- if current.compare_at_price > current.price -%}
            <p class="text-base tabular-nums text-ash line-through" data-compare-price>{{ current.compare_at_price | money_without_trailing_zeros }}</p>
          {%- endif -%}
          {%- unless open -%}
            <span class="rounded-[2px] bg-ink px-2.5 py-1 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-bone">Coming soon</span>
          {%- endunless -%}
        </div>
        {%- unless product.available -%}
          <p class="mt-2 text-[0.9375rem] text-oxblood">Sold out</p>
        {%- endunless -%}

        <div class="rte mt-6 leading-relaxed text-charcoal">{{ product.description }}</div>

        {%- if verse != blank -%}
          <figure class="mt-6 border-l-2 border-ink pl-4">
            <blockquote class="text-lg italic leading-snug"><p>&ldquo;{{ verse }}&rdquo;</p></blockquote>
            {%- if reference != blank -%}
              <figcaption class="mt-2 text-sm text-ash">{{ reference }}, printed on the back</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

        <div class="mt-8">
          {%- render 'product-form', product: product, open: open, category: category, preselected: preselected, section_id: section.id -%}
        </div>

        <ul class="mt-6 space-y-2 text-sm text-ash">
          <li>
            Questions about fit or sizing?
            {% if settings.contact_email != blank -%}
              <a href="mailto:{{ settings.contact_email }}" class="underline underline-offset-4 hover:text-ink">{{ settings.contact_email }}</a>
            {%- else -%}
              <a href="/pages/contact" class="underline underline-offset-4 hover:text-ink">Ask us</a>
            {%- endif %}
          </li>
          {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
            <li>Follow the drop on {% render 'social-links', style: 'inline' %}.</li>
          {%- endif -%}
        </ul>

        <div class="mt-10 divide-y divide-ink/15 border-y border-ink/15">
          {%- assign details_list = details | split: '|' -%}
          {%- if details_list.size > 0 -%}
            <details class="group" open>
              <summary class="caps flex min-h-14 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">
                Details
                <span aria-hidden="true" class="text-xl leading-none transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <div class="pb-5 text-[0.9375rem] leading-relaxed text-charcoal">
                <ul class="list-disc space-y-1 pl-5 marker:text-muted">
                  {%- for line in details_list -%}{%- if line != blank -%}<li>{{ line | strip }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              </div>
            </details>
          {%- endif -%}
          <details class="group" {% if details_list.size == 0 %}open{% endif %}>
            <summary class="caps flex min-h-14 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">
              Material
              <span aria-hidden="true" class="text-xl leading-none transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <div class="pb-5 text-[0.9375rem] leading-relaxed text-charcoal">
              {%- if material != blank -%}<p>{{ material }}</p>{%- else -%}<span class="italic text-ash">Fabric details will be listed here before launch.</span>{%- endif -%}
            </div>
          </details>
          <details class="group">
            <summary class="caps flex min-h-14 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">
              Fit
              <span aria-hidden="true" class="text-xl leading-none transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <div class="pb-5 text-[0.9375rem] leading-relaxed text-charcoal">
              {%- if fit_note != blank -%}
                <p>{{ fit_note }}</p>
              {%- else -%}
                <p><span class="italic text-ash">Fit notes and measurements are coming soon.</span> <a href="/pages/contact" class="underline underline-offset-4">Ask us about sizing</a>.</p>
              {%- endif -%}
            </div>
          </details>
          <details class="group">
            <summary class="caps flex min-h-14 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">
              Care
              <span aria-hidden="true" class="text-xl leading-none transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <div class="pb-5 text-[0.9375rem] leading-relaxed text-charcoal">
              {%- assign care_list = care | split: '|' -%}
              {%- if care_list.size > 0 -%}
                <ul class="space-y-1">{%- for line in care_list -%}{%- if line != blank -%}<li>{{ line | strip }}</li>{%- endif -%}{%- endfor -%}</ul>
              {%- else -%}
                <span class="italic text-ash">Care instructions will be listed here before launch.</span>
              {%- endif -%}
            </div>
          </details>
          <details class="group">
            <summary class="caps flex min-h-14 cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">
              Shipping and returns
              <span aria-hidden="true" class="text-xl leading-none transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <div class="pb-5 text-[0.9375rem] leading-relaxed text-charcoal">
              <div class="space-y-2">
                <p>{%- if settings.shipping_processing != blank -%}Orders ship within {{ settings.shipping_processing }}.{%- else -%}<span class="italic text-ash">Shipping times will be confirmed before launch.</span>{%- endif -%}</p>
                <p>{%- if settings.returns_days != blank -%}Returns accepted within {{ settings.returns_days }} days of delivery.{%- else -%}<span class="italic text-ash">Return terms will be confirmed before launch.</span>{%- endif -%}</p>
                <p><a href="/pages/shipping" class="underline underline-offset-4">Shipping</a><span class="text-ash"> and </span><a href="/pages/returns" class="underline underline-offset-4">returns</a></p>
              </div>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

{%- liquid
  if open and product.available
    assign availability = 'https://schema.org/InStock'
  else
    assign availability = 'https://schema.org/OutOfStock'
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
    "image": [{{ product.featured_media | image_url: width: 1600 | prepend: 'https:' | json }}],
    {%- else -%}
    "image": [{{ 'media-tee-flat-lay-lg.webp' | asset_url | prepend: 'https:' | json }}],
    {%- endif -%}
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    {%- if current.sku != blank -%}"sku": {{ current.sku | json }},{%- endif -%}
    "offers": {
      "@type": "Offer",
      "url": {{ request.origin | append: product.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current.price | divided_by: 100.0 | json }},
      "availability": {{ availability | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "settings": [
    { "type": "paragraph", "content": "Verse, details, material and care come from the product's metafields (custom.scripture_text, custom.scripture_reference, custom.details, custom.material, custom.care). The size guide and fit notes are in Theme settings > Size guide." }
  ]
}
{% endschema %}
