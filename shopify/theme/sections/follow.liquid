{%- liquid
  assign handle = settings.social_handle | default: '@swolvation'
  assign follow_url = settings.social_instagram
  assign follow_label = 'Instagram'
  if follow_url == blank
    assign follow_url = settings.social_tiktok
    assign follow_label = 'TikTok'
  endif
-%}
{%- if follow_url != blank -%}
<section class="gutter bg-bone py-20 md:py-28">
  <div class="flex flex-wrap items-end justify-between gap-8">
    <div>
      <p class="caps text-ash">{{ handle }}</p>
      <h2 class="display mt-4 text-[3.25rem] md:text-[5rem]">{{ section.settings.heading }}</h2>
    </div>
    <ul class="flex flex-wrap gap-3">
      {%- render 'social-links', style: 'button' -%}
    </ul>
  </div>
  <ul class="mt-10 grid grid-cols-2 gap-2 md:mt-14 md:grid-cols-4 md:gap-3">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <a
          href="{{ follow_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block aspect-square overflow-hidden bg-charcoal"
          aria-label="{{ block.settings.alt | escape }}. Follow {{ handle }} on {{ follow_label }}"
        >
          {%- render 'campaign-image', image: block.settings.image, key: block.settings.builtin_image, alt: '', sizes: '(min-width: 768px) 24vw, 46vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:scale-[1.04]' -%}
          <span aria-hidden="true" class="absolute inset-0 grid place-items-center bg-ink/0 text-bone opacity-0 transition-[opacity,background-color] duration-300 group-hover:bg-ink/40 group-hover:opacity-100">
            {%- render 'icon', name: 'instagram', class: 'h-7 w-7' -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  <p class="mt-4 text-sm text-ash">{{ section.settings.caption }}</p>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Follow",
  "class": "section-follow",
  "settings": [
    { "type": "paragraph", "content": "Links go to the social accounts in Theme settings > Brand." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the work." },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Frames from the first-drop campaign." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "builtin_image", "label": "Built-in image", "default": "knurling",
          "options": [
            { "value": "knurling", "label": "Barbell knurling" },
            { "value": "chalk", "label": "Chalk dust" },
            { "value": "dumbbells", "label": "Dumbbells" },
            { "value": "vintage-gym", "label": "Vintage gym" },
            { "value": "tee-gym-hook", "label": "Tee on the hook" },
            { "value": "ls-gym-hook", "label": "Long sleeve on the hook" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Description (alt text)" }
      ]
    }
  ],
  "presets": [{ "name": "Follow" }]
}
{% endschema %}
