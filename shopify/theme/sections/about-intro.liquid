<section data-reveal-scope class="gutter bg-bone pb-16 pt-14 md:pb-24 md:pt-20">
  <p class="caps text-ash">{{ section.settings.eyebrow }}</p>
  <h1 class="display mt-4 max-w-[12ch] text-[3.75rem] sm:text-[5.5rem] lg:text-[8rem]">{{ section.settings.heading }}</h1>
  <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-12">
    <p data-rise class="text-2xl leading-snug md:col-span-7 md:text-[2rem]">{{ section.settings.lead }}</p>
    <p data-rise class="max-w-[44ch] text-lg leading-relaxed text-charcoal md:col-span-4 md:col-start-9">{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "About: intro",
  "class": "section-about-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Strength has a purpose." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Swolvation is about the relationship between physical strength, mental discipline, faith and perseverance." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The gym is where we test ourselves physically. But what you build there, the patience, the stubbornness, the habit of getting back up, carries into everything else." }
  ],
  "presets": [{ "name": "About: intro" }]
}
{% endschema %}
