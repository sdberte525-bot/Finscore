<div data-tone="dark" class="grid min-h-[100svh] bg-ink text-bone lg:grid-cols-12">
  <div class="relative lg:order-last lg:col-span-6">
    {%- render 'loop-video',
      src: section.settings.video_url,
      poster_key: 'poster-ls-dawn',
      poster_image: section.settings.poster,
      alt: 'The Through Christ long sleeve hanging in a gym at dawn',
      sizes: '(min-width: 1024px) 50vw, 100vw',
      priority: true,
      class: 'aspect-[4/5] lg:absolute lg:inset-0 lg:aspect-auto'
    -%}
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink to-transparent lg:inset-y-0 lg:left-0 lg:h-auto lg:w-32 lg:bg-gradient-to-r"></div>
  </div>
  <div class="gutter relative flex flex-col justify-between gap-12 pb-12 pt-10 lg:col-span-6 lg:py-14">
    <p class="wordmark text-[1.375rem] md:text-[1.625rem]">{{ shop.name }}</p>
    <div>
      <p class="caps text-stone">{{ section.settings.eyebrow }}</p>
      <h1 class="display mt-4 text-[4rem] sm:text-[5.5rem] xl:text-[7rem]">{{ section.settings.heading }}</h1>
      <p class="mt-6 max-w-[38ch] text-lg leading-relaxed text-stone">{{ shop.password_message | default: section.settings.text }}</p>
      <div class="mt-9">
        {%- render 'newsletter-form', id: 'password', source: 'password-page', cta: 'Get first access', done: 'You’re on the list. Watch your inbox.' -%}
      </div>
      <ul class="mt-4 flex flex-wrap gap-3" aria-label="Follow {{ shop.name }}">
        {%- render 'social-links', style: 'footer' -%}
      </ul>
    </div>
    <details class="text-sm text-stone">
      <summary class="cursor-pointer list-none underline underline-offset-4 [&::-webkit-details-marker]:hidden">Store owner? Enter with the password</summary>
      {%- form 'storefront_password', class: 'mt-4 flex max-w-md flex-col gap-3 sm:flex-row' -%}
        <label for="store-password" class="sr-only">Password</label>
        <input id="store-password" type="password" name="password" autocomplete="current-password" placeholder="Password" class="field border-bone/40 text-bone placeholder:text-stone focus:border-bone">
        <button type="submit" class="button button-light shrink-0">Enter</button>
        {%- if form.errors -%}<p role="alert" class="text-bone sm:basis-full">Wrong password.</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The first drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Used when no message is set in Online Store > Preferences > Password protection.", "default": "Vintage-inspired training apparel rooted in strength, discipline and faith. Get first access before the drop is announced anywhere else." },
    { "type": "text", "id": "video_url", "label": "Video URL (MP4)", "default": "https://d2ol7oe51mr4n9.cloudfront.net/user_3KW4bOaWnBSh6zRqm3msREW6Jea/98428e0f-58a6-4d16-aaf8-5859fe8f642f.mp4" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" }
  ]
}
{% endschema %}
