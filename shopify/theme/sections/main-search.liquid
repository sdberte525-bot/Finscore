<div class="gutter min-h-[80vh] bg-bone pb-24 pt-12 md:pb-32 md:pt-16">
  <h1 class="display text-[3.5rem] md:text-[6rem]">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 flex max-w-xl gap-3">
    <input type="hidden" name="type" value="product">
    <label for="search-page-input" class="sr-only">Search products</label>
    <input id="search-page-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the collection" class="field border-ink/30 focus:border-ink">
    <button type="submit" class="button button-solid shrink-0">Search</button>
  </form>
  {%- if search.performed -%}
    <p class="caps mt-10 text-ash">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</p>
    {%- assign products = search.results | where: 'object_type', 'product' -%}
    {%- if products.size == 0 -%}
      <p class="mt-6 text-lg">Nothing matches &ldquo;{{ search.terms }}&rdquo;. Try a product name or a verse, like &ldquo;Joshua&rdquo;.</p>
    {%- else -%}
      <div class="mt-8" data-reveal-tiles>{%- render 'product-grid', products: products -%}</div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
