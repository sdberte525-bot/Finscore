[
  {
    "name": "theme_info",
    "theme_name": "Swolvation",
    "theme_version": "1.0.0",
    "theme_author": "Swolvation",
    "theme_documentation_url": "https://github.com/sdberte525-bot/Finscore/blob/main/SHOPIFY_MIGRATION.md",
    "theme_support_email": "swolvation@gmail.com"
  },
  {
    "name": "Store status",
    "settings": [
      {
        "type": "select",
        "id": "store_mode",
        "label": "Store status",
        "options": [
          {
            "value": "open",
            "label": "Open: add to cart and checkout"
          },
          {
            "value": "prelaunch",
            "label": "Pre-launch: \"Coming soon\" and \"Notify me\" sign-ups"
          }
        ],
        "default": "open",
        "info": "Pre-launch hides add to cart and collects per-size sign-ups instead. Switch to Open on drop day."
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "select",
        "id": "launch_gallery",
        "label": "Photos for the two launch pieces",
        "options": [
          {
            "value": "campaign",
            "label": "Campaign photos and videos (built into the theme)"
          },
          {
            "value": "shopify",
            "label": "Photos uploaded to the product in Shopify"
          }
        ],
        "default": "campaign",
        "info": "Keeps the campaign photography even when a print-on-demand app adds mockup images to the products. Every other product always uses its Shopify photos."
      },
      {
        "type": "checkbox",
        "id": "card_hover_video",
        "label": "Play the turn video when hovering product cards",
        "default": true
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline",
        "default": "Built through adversity."
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Customer email",
        "default": "swolvation@gmail.com"
      },
      {
        "type": "text",
        "id": "legal_name",
        "label": "Legal business name",
        "info": "Shown in the footer. Leave blank to use the store name."
      },
      {
        "type": "header",
        "content": "Social"
      },
      {
        "type": "text",
        "id": "social_handle",
        "label": "Handle",
        "default": "@swolvation"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://www.instagram.com/swolvation"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "default": "https://www.tiktok.com/@swolvation"
      },
      {
        "type": "header",
        "content": "Share image"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social share image",
        "info": "Used when a page has no image of its own. Defaults to the tee flat lay."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square, at least 64 × 64px."
      }
    ]
  },
  {
    "name": "Shipping and returns",
    "settings": [
      {
        "type": "paragraph",
        "content": "Leave a field blank and the site says it will be confirmed before launch, so nothing is promised early."
      },
      {
        "type": "text",
        "id": "shipping_regions",
        "label": "Where you ship",
        "info": "e.g. the United States and Canada"
      },
      {
        "type": "text",
        "id": "shipping_processing",
        "label": "Processing time",
        "info": "e.g. 2 to 5 business days"
      },
      {
        "type": "text",
        "id": "shipping_delivery",
        "label": "Delivery estimate",
        "info": "e.g. 3 to 7 business days within the US"
      },
      {
        "type": "text",
        "id": "shipping_rates",
        "label": "Shipping rates",
        "info": "e.g. Free on orders over $100, otherwise calculated at checkout"
      },
      {
        "type": "number",
        "id": "returns_days",
        "label": "Return window (days)"
      },
      {
        "type": "text",
        "id": "returns_condition",
        "label": "Return condition",
        "info": "e.g. Unworn and unwashed"
      },
      {
        "type": "text",
        "id": "returns_exchanges",
        "label": "Exchanges"
      },
      {
        "type": "text",
        "id": "returns_refunds",
        "label": "Refunds"
      }
    ]
  },
  {
    "name": "Size guide",
    "settings": [
      {
        "type": "paragraph",
        "content": "One row per line: size, then each measurement, separated by commas. Measurements are in inches."
      },
      {
        "type": "checkbox",
        "id": "size_approximate",
        "label": "Measurements are approximate",
        "default": false,
        "info": "On: the size guide notes measurements may vary by about half an inch. The current charts are the print partner's published flat measurements."
      },
      {
        "type": "header",
        "content": "Short sleeves"
      },
      {
        "type": "text",
        "id": "size_tee_columns",
        "label": "Columns",
        "default": "Size, Chest (pit to pit), Length, Shoulder, Fits chest"
      },
      {
        "type": "textarea",
        "id": "size_tee_rows",
        "label": "Rows",
        "default": "XS, 20.9, 26.0, 21.5, 32–34\nS, 21.7, 26.8, 21.3, 35–37\nM, 22.6, 28.0, 22.0, 38–40\nL, 23.6, 29.1, 22.8, 41–43\nXL, 24.6, 30.3, 23.6, 44–47\n2XL, 25.6, 31.5, 24.4, 48–51"
      },
      {
        "type": "textarea",
        "id": "size_tee_fit",
        "label": "Fit note",
        "default": "Boxy and relaxed. Take your usual size for the boxy fit, or size up for an oversized look."
      },
      {
        "type": "range",
        "id": "size_tee_fitted",
        "label": "\"Closer\" fit: sizes to move",
        "min": -2,
        "max": 2,
        "step": 1,
        "default": -1
      },
      {
        "type": "range",
        "id": "size_tee_relaxed",
        "label": "\"Roomier\" fit: sizes to move",
        "min": -2,
        "max": 2,
        "step": 1,
        "default": 1
      },
      {
        "type": "header",
        "content": "Long sleeves"
      },
      {
        "type": "text",
        "id": "size_ls_columns",
        "label": "Columns",
        "default": "Size, Chest (pit to pit), Length, Sleeve, Fits chest"
      },
      {
        "type": "textarea",
        "id": "size_ls_rows",
        "label": "Rows",
        "default": "XS, 18.9, 26.0, 22.4, 32–34\nS, 19.7, 26.8, 23.0, 35–37\nM, 20.5, 27.6, 23.6, 38–40\nL, 21.5, 28.3, 24.2, 41–43\nXL, 22.4, 29.1, 24.8, 44–47\n2XL, 24.4, 30.7, 25.4, 48–51\n3XL, 26.4, 32.3, 26.0, 52–55"
      },
      {
        "type": "textarea",
        "id": "size_ls_fit",
        "label": "Fit note",
        "default": "A closer, classic fit than the boxy tee. Take your usual size for a fitted look, or size up for a relaxed fit."
      },
      {
        "type": "range",
        "id": "size_ls_fitted",
        "label": "\"Closer\" fit: sizes to move",
        "min": -2,
        "max": 2,
        "step": 1,
        "default": 0
      },
      {
        "type": "range",
        "id": "size_ls_relaxed",
        "label": "\"Roomier\" fit: sizes to move",
        "min": -2,
        "max": 2,
        "step": 1,
        "default": 1
      }
    ]
  },
  {
    "name": "Email popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "popup_enabled",
        "label": "Show the first-access popup",
        "default": true
      },
      {
        "type": "range",
        "id": "popup_delay",
        "label": "Delay",
        "min": 5,
        "max": 60,
        "step": 5,
        "unit": "s",
        "default": 30
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Image",
        "info": "Defaults to the long sleeve hanging in the gym."
      },
      {
        "type": "text",
        "id": "popup_heading",
        "label": "Heading",
        "default": "Hear it first."
      },
      {
        "type": "textarea",
        "id": "popup_text",
        "label": "Text",
        "default": "New pieces and restocks, by email. Nothing else."
      }
    ]
  }
]
