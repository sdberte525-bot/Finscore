<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#111111">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'icon.svg' | asset_url }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {{ 'archivo-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'big-shoulders-latin-800-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%} Lets CSS hide intro-animated elements before first paint, only when JS will animate them. {%- endcomment -%}
    <script>document.documentElement.dataset.js = '';</script>
    <script>
      window.Swolvation = {
        storeOpen: {{ settings.store_mode | default: 'open' | json }} === 'open',
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }}
        }
      };
    </script>
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:text-bone"
    >
      Skip to content
    </a>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'search-dialog' %}
    {% render 'email-popup' %}

    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
