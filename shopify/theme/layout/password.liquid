<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#111111">
    <link rel="icon" type="image/svg+xml" href="{{ 'icon.svg' | asset_url }}">
    {%- render 'meta-tags' -%}
    {{ 'big-shoulders-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>window.Swolvation = { storeOpen: false, routes: {} };</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="bg-ink">
    <main id="main">{{ content_for_layout }}</main>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
