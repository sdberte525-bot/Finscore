{%- comment -%} Product grid that sizes its columns to the catalog: two large cards, three, or four across. Params: products, filterable {%- endcomment -%}
{%- liquid
  assign count = products.size
  if count <= 2
    assign columns = 'sm:grid-cols-2'
    assign sizes = '(min-width: 640px) 48vw, 92vw'
  elsif count == 3
    assign columns = 'sm:grid-cols-2 lg:grid-cols-3'
    assign sizes = '(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 92vw'
  else
    assign columns = 'sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4'
    assign sizes = '(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 92vw'
  endif
-%}
<div class="grid gap-x-5 gap-y-12 md:gap-x-8 {{ columns }}" data-grid>
  {%- for product in products -%}
    {%- capture category -%}{%- render 'product-merch', product: product, field: 'category' -%}{%- endcapture -%}
    <div data-category="{{ category }}">
      {%- assign eager = false -%}
      {%- if forloop.index <= 2 -%}{%- assign eager = true -%}{%- endif -%}
      {%- render 'product-card', product: product, sizes: sizes, priority: eager -%}
    </div>
  {%- endfor -%}
</div>
