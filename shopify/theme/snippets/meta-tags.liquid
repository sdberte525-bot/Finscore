{%- liquid
  assign brand_line = 'vintage-inspired gym and lifestyle clothing'
  if request.page_type == 'index'
    if page_title == shop.name or page_title == blank
      assign seo_title = shop.name | append: ': ' | append: brand_line
    else
      assign seo_title = page_title
    endif
  else
    assign seo_title = page_title | append: ' | ' | append: shop.name
    if current_tags
      assign seo_title = page_title | append: ' (' | append: current_tags | join: ', ' | append: ') | ' | append: shop.name
    endif
    if current_page != 1
      assign seo_title = seo_title | append: ' (page ' | append: current_page | append: ')'
    endif
  endif

  assign seo_description = page_description | default: shop.description | default: 'Vintage-inspired training apparel rooted in strength, discipline, and purpose.'

  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<title>{{ seo_title | strip }}</title>
<meta name="description" content="{{ seo_description | strip_html | escape }}">

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ seo_description | strip_html | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- if page_image.alt != blank -%}<meta property="og:image:alt" content="{{ page_image.alt | escape }}">{%- endif -%}
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: settings.share_image.aspect_ratio | round }}">
{%- else -%}
  <meta property="og:image" content="https:{{ 'media-tee-flat-lay-lg.webp' | asset_url }}">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="1589">
  <meta property="og:image:alt" content="The Swolvation Be Strong &amp; Courageous tee laid flat on a gym floor">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
<meta name="twitter:description" content="{{ seo_description | strip_html | escape }}">
