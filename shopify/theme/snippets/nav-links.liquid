{%- comment -%}
  The main navigation as a list of url|label pairs. Uses the menu picked in the header
  settings, or Swolvation's own four links when none is picked.
  Output is captured by the caller: {% capture nav %}{% render 'nav-links', menu: section.settings.menu %}{% endcapture %}
{%- endcomment -%}
{%- if menu != blank and linklists[menu].links.size > 0 -%}
  {%- for link in linklists[menu].links -%}{{ link.url }}|{{ link.title }}{% unless forloop.last %}^^{% endunless %}{%- endfor -%}
{%- else -%}
  {%- comment -%} Pages and collections that don't exist yet are left out, so no menu link lands on a 404. {%- endcomment -%}
  {{- routes.all_products_collection_url }}|Shop^^
  {%- if collections['new-drop'].id != blank -%}{{ collections['new-drop'].url }}|New drop^^{%- endif -%}
  {%- if pages.about.url != blank -%}{{ pages.about.url }}|Our story^^{%- endif -%}
  /pages/contact|Contact
{%- endif -%}
