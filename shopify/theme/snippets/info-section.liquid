{%- comment -%} One titled block on an information page. Params: title, body (HTML) {%- endcomment -%}
<section class="border-t border-ink/15 pt-8">
  <h2 class="display text-[1.875rem] md:text-[2.25rem]">{{ title }}</h2>
  <div class="prose-body mt-5 max-w-[62ch] text-[1.0625rem] leading-relaxed text-charcoal">{{ body }}</div>
</section>
