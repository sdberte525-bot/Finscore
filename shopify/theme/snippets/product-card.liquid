{%- comment -%} Product card for grids. Params: product, sizes, priority {%- endcomment -%}
{%- liquid
  assign open = false
  if settings.store_mode == 'open'
    assign open = true
  endif
  capture key
    render 'product-merch', product: product, field: 'key'
  endcapture
  capture category
    render 'product-merch', product: product, field: 'category'
  endcapture
  capture reference
    render 'product-merch', product: product, field: 'scripture_reference'
  endcapture
  capture card_key
    render 'product-merch', product: product, field: 'card_key'
  endcapture
  if settings.card_hover_video
    capture turn
      render 'product-merch', product: product, field: 'turn_video'
    endcapture
  endif
  capture turn_poster
    render 'product-merch', product: product, field: 'turn_poster'
  endcapture

  assign use_campaign = false
  if card_key != blank and settings.launch_gallery != 'shopify'
    assign use_campaign = true
  endif
  if card_key != blank and product.featured_media == blank
    assign use_campaign = true
  endif

  assign color_option = nil
  assign size_option = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_option = option
    elsif oname == 'size'
      assign size_option = option
    endif
  endfor

  assign color_count = 1
  if color_option
    assign color_count = color_option.values.size
  endif
  assign quick_add = false
  if open and product.available and color_count == 1 and product.has_only_default_variant == false
    assign quick_add = true
  endif

  if category == 'long-sleeve'
    assign kind = 'long sleeve'
  elsif key == 'tee'
    assign kind = 'oversized tee'
  else
    assign kind = product.type | downcase | default: 'tee'
  endif
  assign url = product.url | within: collection
-%}
<article class="group" data-product-card>
  <div data-reveal-tile class="relative aspect-[4/5] overflow-hidden bg-charcoal">
    <a href="{{ url }}" class="absolute inset-0 block" aria-label="{{ product.title | escape }}" tabindex="-1">
      <div data-reveal-image class="absolute inset-0">
        {%- assign img_class = 'absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-out-quint)] pointer-fine:group-hover:scale-[1.03]' -%}
        {%- if use_campaign -%}
          {%- render 'media-image', key: card_key, sizes: sizes, class: img_class, priority: priority -%}
        {%- elsif product.featured_media -%}
          {%- liquid
            assign ld = 'lazy'
            if priority
              assign ld = 'eager'
            endif
            assign card_alt = product.featured_media.alt | default: product.title
          -%}
          {{ product.featured_media | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: sizes, class: img_class, loading: ld, alt: card_alt }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full bg-charcoal fill-stone/30' }}
        {%- endif -%}
        {%- if turn != blank -%}
          <video
            data-card-video
            data-src="{{ turn }}"
            {% if turn_poster != blank %}poster="{{ 'media-' | append: turn_poster | append: '-sm.webp' | asset_url }}"{% endif %}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500"
          ></video>
        {%- endif -%}
      </div>
    </a>

    {%- unless product.available -%}
      <span class="absolute left-3 top-3 rounded-[2px] bg-bone/90 px-3 py-1 text-xs text-charcoal">Sold out</span>
    {%- endunless -%}
    {%- unless open -%}
      <span class="absolute left-3 top-3 rounded-[2px] bg-ink/80 px-3 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-bone backdrop-blur-md">Coming soon</span>
    {%- endunless -%}

    {%- if turn != blank -%}
      <button
        type="button"
        data-card-turn
        aria-pressed="false"
        class="absolute right-3 top-3 z-10 min-h-10 rounded-[2px] bg-bone/90 px-4 text-sm text-charcoal backdrop-blur-md pointer-fine:hidden"
      >Turn</button>
    {%- endif -%}

    {%- if quick_add -%}
      <div
        data-quick-panel
        class="pointer-events-none absolute inset-x-3 bottom-3 z-10 translate-y-3 opacity-0 transition-[opacity,transform] duration-500 ease-[var(--ease-out-quint)] group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100 pointer-fine:group-hover:pointer-events-auto pointer-fine:group-hover:translate-y-0 pointer-fine:group-hover:opacity-100"
      >
        <div class="flex items-center justify-between gap-3 rounded-[2px] bg-bone/95 py-1.5 pl-5 pr-1.5 backdrop-blur-md">
          <span class="text-sm text-charcoal">Add</span>
          <ul class="flex gap-0.5" aria-label="Add {{ product.title | escape }} to cart, choose a size">
            {%- for variant in product.variants -%}
              {%- liquid
                if size_option
                  assign size_index = size_option.position | minus: 1
                  assign size_label = variant.options[size_index]
                else
                  assign size_label = variant.title
                endif
              -%}
              <li>
                <button
                  type="button"
                  data-quick-add="{{ variant.id }}"
                  {% unless variant.available %}disabled{% endunless %}
                  class="grid h-10 min-w-10 place-items-center rounded-[2px] px-1.5 text-sm transition-colors hover:bg-ink hover:text-bone disabled:text-stone disabled:line-through disabled:hover:bg-transparent"
                  aria-label="Size {{ size_label }}{% unless variant.available %}, sold out{% endunless %}"
                >{{ size_label }}</button>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="mt-4 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="text-base leading-snug">
        <a href="{{ url }}" class="link-underline">{{ product.title }}</a>
      </h3>
      <div class="mt-2 flex items-center gap-2">
        {%- if color_option -%}
          <ul class="flex gap-1.5" aria-label="Colors">
            {%- for value in color_option.values -%}
              {%- capture hex -%}{%- render 'swatch', value: value -%}{%- endcapture -%}
              <li>
                <span class="block h-3.5 w-3.5 rounded-full ring-1 ring-ink/25 ring-offset-1 ring-offset-bone" style="background: {{ hex }}" title="{{ value | escape }}"></span>
                <span class="sr-only">{{ value }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <span class="text-sm text-ash">
          {%- if color_option -%}
            {%- if color_count == 1 -%}{{ color_option.values.first }}{%- else -%}{{ color_count }} colors{%- endif -%},{{ ' ' }}
          {%- endif -%}
          {{- kind -}}
        </span>
      </div>
      {%- if reference != blank -%}
        <p class="mt-1.5 text-xs uppercase tracking-[0.14em] text-ash">{{ reference }}</p>
      {%- endif -%}
    </div>
    <div class="flex shrink-0 flex-col items-end gap-1.5">
      <p class="text-base tabular-nums">
        {%- if product.price_varies -%}From {% endif -%}
        {{- product.price_min | money_without_trailing_zeros -}}
      </p>
      {%- if quick_add -%}
        <button type="button" data-quick-toggle aria-expanded="false" class="py-1 text-sm text-ash underline underline-offset-4 pointer-fine:hidden">Quick add</button>
      {%- endif -%}
    </div>
  </div>
</article>
