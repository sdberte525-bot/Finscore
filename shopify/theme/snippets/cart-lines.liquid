{%- comment -%} Cart line items with quantity steppers ([data-line] in theme.js). Params: compact {%- endcomment -%}
<ul class="divide-y divide-ink/15">
  {%- for item in cart.items -%}
    {%- liquid
      capture card_key
        render 'product-merch', product: item.product, field: 'card_key'
      endcapture
      assign size_value = ''
      assign other_values = ''
      for option in item.options_with_values
        assign oname = option.name | downcase
        if oname == 'size'
          assign size_value = option.value
        elsif option.name != 'Title'
          if other_values == blank
            assign other_values = option.value
          else
            assign other_values = other_values | append: ', ' | append: option.value
          endif
        endif
      endfor
      assign max = 10
      if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
        assign max = item.variant.inventory_quantity | at_most: 10
      endif
      if compact
        assign grid = 'grid-cols-[5.5rem_1fr]'
      else
        assign grid = 'grid-cols-[6.5rem_1fr] md:grid-cols-[8rem_1fr]'
      endif
    -%}
    <li class="grid gap-5 py-6 {{ grid }}" data-line="{{ item.key }}" data-variant-id="{{ item.variant_id }}" data-quantity="{{ item.quantity }}" data-max="{{ max }}">
      <a href="{{ item.url }}" class="relative block aspect-[4/5] overflow-hidden bg-studio">
        {%- if card_key != blank and settings.launch_gallery != 'shopify' -%}
          {%- render 'media-image', key: card_key, alt: item.product.title, sizes: '128px', class: 'h-full w-full object-contain p-1.5' -%}
        {%- elsif item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: alt: item.product.title, class: 'h-full w-full object-contain p-1.5', loading: 'lazy' }}
        {%- endif -%}
      </a>
      <div class="flex min-w-0 flex-col">
        <div class="flex items-start justify-between gap-4">
          <div>
            <a href="{{ item.url }}" class="link-underline text-sm">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}
              <p class="mt-1 text-xs text-ash">
                {%- if other_values != blank -%}{{ other_values }}{%- endif -%}
                {%- if size_value != blank -%}{%- if other_values != blank -%}, size {% else %}Size {% endif -%}{{ size_value }}{%- endif -%}
              </p>
            {%- endunless -%}
            {%- for discount in item.line_level_discount_allocations -%}
              <p class="mt-1 text-xs text-ash">{{ discount.discount_application.title }} (&minus;{{ discount.amount | money_without_trailing_zeros }})</p>
            {%- endfor -%}
            {%- if compact -%}
              <p class="mt-1 text-xs text-oxblood" role="status" data-added-note hidden>Added to cart</p>
            {%- endif -%}
          </div>
          <p class="text-sm tabular-nums">
            {%- if item.original_line_price != item.final_line_price -%}
              <s class="text-ash">{{ item.original_line_price | money_without_trailing_zeros }}</s>
            {%- endif -%}
            {{ item.final_line_price | money_without_trailing_zeros }}
          </p>
        </div>
        <div class="mt-auto flex items-center justify-between pt-4">
          <div class="flex items-center rounded-[2px] border border-ink/25 text-sm" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
            <button type="button" class="grid h-9 w-9 place-items-center" data-line-minus aria-label="Decrease quantity">&minus;</button>
            <span class="w-6 text-center tabular-nums" aria-live="polite">{{ item.quantity }}</span>
            <button type="button" class="grid h-9 w-9 place-items-center disabled:opacity-30" data-line-plus {% if item.quantity >= max %}disabled{% endif %} aria-label="Increase quantity">+</button>
          </div>
          <button type="button" data-line-remove class="link-underline text-xs text-ash">Remove</button>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
