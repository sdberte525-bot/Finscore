{
  "name": "swolvation-shopify-theme",
  "private": true,
  "description": "Build tooling for the Swolvation Shopify theme in ./theme",
  "scripts": {
    "build": "node scripts/build.mjs",
    "media": "node scripts/fetch-media.mjs",
    "check": "shopify theme check --path theme",
    "dev": "shopify theme dev --path theme",
    "push": "shopify theme push --path theme --unpublished"
  },
  "devDependencies": {
    "@shopify/cli": "^3.94.3",
    "@tailwindcss/cli": "4.3.3",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3"
  }
}
